# MassIVE/GNPS open-format index record.
OPENFORMATS_RECORD_ID=4549746
OPENFORMATS_INDEX_DIR=data/openformats

# Local persistent state.
STATE_DATABASE_URL=data/gnps_massive_to_mgf.sqlite

# Raw open-format downloads and generated MGF shards.
MZML_DOWNLOAD_DIR=/mnt/bfd/mzml
MGF_OUTPUT_DIR=/mnt/bfd/mgf

# Initial corpus target and conversion policy.
TARGET_MS2_SPECTRA=200000000
TOP_K_PEAKS=256
MGF_SHARD_MAX_SPECTRA=1000000
SOURCE_SELECTION_BUFFER=1.25
SOURCE_SELECTION_CHUNK_MS2=50000000

# Downloads run sequentially with a single worker. MassIVE fair-shares
# bandwidth across concurrent connections from the same IP and additionally
# throttles bursts (HTTPS via mod_qos, FTPS via SFTPGo per-IP caps), so adding
# workers does not increase aggregate throughput and risks triggering an
# abuser cool-down that degrades all subsequent connections.
DOWNLOAD_RETRY_ATTEMPTS=3
DOWNLOAD_RETRY_DELAY_SECONDS=30

# Anonymous FTPS bulk-download endpoint per MassIVE admin guidance.
FTPS_HOST=massive-ftp.ucsd.edu
FTPS_PORT=21
# Trust-On-First-Use pin for the FTPS server's self-signed cert.
# Delete the file to re-trust after MassIVE rotates the certificate.
FTPS_CERT_PIN_PATH=data/ftps_cert_pin.txt
FTPS_CONNECT_TIMEOUT_SECONDS=30
# Set to 0 to disable the full-transfer timeout for very large files.
FTPS_TRANSFER_TIMEOUT_SECONDS=600
